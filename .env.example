# Copy to `.env` and fill in. `.env` is gitignored.

# Spotify OAuth (required). Same app as duudey.com so the access/refresh
# tokens are interchangeable across SSO partners.
SPOTIFY_CLIENT_ID=ENTER_YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=ENTER_YOUR_SPOTIFY_CLIENT_SECRET

# Server: public URL the Spotify OAuth redirect returns to; port the app
# binds inside the container (also the port compose publishes).
TRT_URL=https://thatradiothing.duudey.com/
TRT_PORT=33408

# Sync loop tolerance (ms) before re-seeking master position.
TRT_REALTIME_TOLERANCE_MS=1000

# Comma-separated Spotify user IDs allowed to become "master" (they set
# what everyone else listens to).
TRT_MASTERS_LIST=ENTER_AT_LEAST_ONE_SPOTIFY_USER_ID

# Comma-separated Spotify user IDs allowed to manage radio schedules and
# AutoDJ controls. This is deliberately separate from TRT_MASTERS_LIST.
TRT_ADMIN_IDS=ENTER_RADIO_ADMIN_SPOTIFY_USER_ID

# Comma-separated OAuth scopes requested from Spotify. Must be a superset
# of what any shared-SSO partner (e.g. duudey.com) also requests.
TRT_SCOPES=user-modify-playback-state,user-read-playback-state

# AutoDJ playlists, JSON-encoded array of {"uri": "..."} objects.
TRT_PLAYLISTS=[{"uri":"ENTER_YOUR_PLAYLIST_URI"}]

# SQLite data is persisted in this directory. TRT_PLAYLISTS is imported only
# once as a backwards-compatible bootstrap; the database becomes authoritative.
TRT_DATABASE_PATH=/app/data/thatradiothing.sqlite3
TRT_SCHEDULE_TIMEZONE=Europe/Istanbul
TRT_CATALOG_REFRESH_INTERVAL_SECONDS=21600
# Optional refresh token for a dedicated Spotify account that owns/collaborates
# on private radio playlists. Keep this server-side; do not use an admin token.
TRT_CATALOG_REFRESH_TOKEN=

# Auth cookie. Must match the duudey.com deployment exactly so the JWT
# cookie is readable across subdomains and both sides verify the same
# signature. `.duudey.com` scope makes it visible to duudey.com and all
# its subdomains including thatradiothing.duudey.com.
AUTH_COOKIE_NAME=duudey_auth
AUTH_COOKIE_DOMAIN=.duudey.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_TOKEN_TTL_SECONDS=2592000
AUTH_JWT_ISSUER=duudey-auth
AUTH_SHARED_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# CORS: comma-separated origins that may call this API cross-origin with
# credentials (primarily duudey.com so the front-end can fetch /status).
CORS_ALLOWED_ORIGINS=https://duudey.com,https://www.duudey.com,https://thatradiothing.duudey.com,https://admin.duudey.com
CORS_ALLOW_CREDENTIALS=true

# Browser origins allowed to mutate the admin API. If empty, the CORS list is
# used. Include the future duudey-admin origin when it calls the API directly.
TRT_ADMIN_ORIGINS=https://thatradiothing.duudey.com,https://admin.duudey.com

# Rotating log file. Path is inside the container; docker-compose mounts
# /app/logs to ./logs on the host, so the files appear next to
# docker-compose.yml. Set LOG_FILE to an empty value to disable file
# logging and rely on stdout only (`docker compose logs`).
LOG_LEVEL=INFO
LOG_FILE=/app/logs/thatradiothing.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
